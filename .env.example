# ==============================================================================
# STRAP AI Fitness — Production Environment Variables Template
# Copy to .env.local for local dev. Set in Vercel Project Settings -> Environment
# Variables for production. NEVER commit .env.local or real secrets to GitHub.
# ==============================================================================

# 1. Public Site URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase (Project Settings -> API)
# Publishable / Anon key is safe for browser use under RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# SERVER-ONLY! NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Owner Admin Gmail (SERVER-ONLY — sole account allowed into /admin & /api/admin/*)
STRAP_ADMIN_EMAIL=YOUR_GMAIL_ADDRESS

# 4. Google Gemini AI (SERVER-ONLY — https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# 5. Manual UPI Payment Settings
NEXT_PUBLIC_UPI_ID=your-upi-id@bank
NEXT_PUBLIC_UPI_NAME=STRAP Fitness
NEXT_PUBLIC_PREMIUM_PRICE_INR=100

# 6. Optional: Razorpay Gateway (SERVER-ONLY except key id returned by /api/payments/order)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
